{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alpic analytics deployments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "deployments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a deployment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alpic.ai/v1/deployments/:deploymentId",
            "params": [
              {
                "name": "deploymentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a deployment by ID"
        }
      ]
    }
  ],
  "bundled": true
}